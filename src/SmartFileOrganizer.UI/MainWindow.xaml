<Window Background="{DynamicResource AppBackground}" FlowDirection="{DynamicResource AppFlowDirection}" Height="600" Title="{DynamicResource StrMainWindowTitle}" Width="800" WindowStartupLocation="CenterScreen" Icon="Assets/Branding/SmartFileOrganizer.ico" x:Class="SmartFileOrganizer.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SmartFileOrganizer.UI.ViewModels" xmlns:v="clr-namespace:SmartFileOrganizer.UI.Views">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <v:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBackground}" Grid.Column="0">
            <StackPanel Margin="10,20,10,10">
                <Image Source="Assets/Branding/SmartFileOrganizer-Logo.png" Height="43.2" Stretch="Uniform" Margin="0,0,0,5" />
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30" Text="{DynamicResource StrSidebarTitle}" />
                <Button Background="{DynamicResource SidebarButtonInactive}" BorderThickness="0" Click="DashboardButton_Click" Content="{DynamicResource StrBtnDashboard}" FontSize="14" Foreground="White" Height="40" Margin="0,0,0,10" x:Name="DashboardButton" />
                <Button Background="{DynamicResource SidebarButtonInactive}" BorderThickness="0" Click="OverviewButton_Click" Content="{DynamicResource StrBtnOverview}" FontSize="14" Foreground="White" Height="40" Margin="0,0,0,10" x:Name="OverviewButton" />
                <Button Background="{DynamicResource SidebarButtonInactive}" BorderThickness="0" Click="SettingsButton_Click" Content="{DynamicResource StrBtnSettings}" FontSize="14" Foreground="White" Height="40" Margin="0,0,0,10" x:Name="SettingsButton" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Grid.Column="1" Margin="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="1" />
            </Border.Effect>
            <ContentControl Content="{ Binding CurrentViewModel }" />
        </Border>
    </Grid>
</Window>
