<UserControl x:Class="SmartFileOrganizer.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Bar with Reset Button -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource ControlBorder}" Grid.Column="0" Height="30" Padding="5" VerticalContentAlignment="Center" Text="{ Binding TargetPath, UpdateSourceTrigger=PropertyChanged }" />
                <Button Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource ControlBorder}" Command="{ Binding BrowseScanCommand }" Content="{DynamicResource StrBtnBrowse}" Grid.Column="1" Height="30" Margin="10,0,0,0" Width="80"/>
                <Button Background="{DynamicResource CardBackground1}" BorderThickness="0" Command="{ Binding StartScanCommand }" Content="{DynamicResource StrBtnStartScan}" Foreground="White" Grid.Column="2" Height="30" Margin="10,0,0,0" Width="100"/>
                <Button Background="{DynamicResource MutedText}" BorderThickness="0" Command="{ Binding ResetScanCommand }" Content="{DynamicResource StrBtnReset}" Foreground="White" Grid.Column="3" Height="30" Margin="10,0,0,0" Width="80"/>
            </Grid>

            <!-- Progress Bar & Text -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="{ Binding ProgressText }" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Left" />
                <ProgressBar Height="5" IsIndeterminate="{ Binding IsScanning }" />
            </StackPanel>

            <!-- Results DataGrid -->
            <DataGrid AlternatingRowBackground="{DynamicResource DataGridAltRowBackground}" AutoGenerateColumns="False" Background="{DynamicResource DataGridBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CanUserAddRows="False" Grid.Row="2" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" ItemsSource="{ Binding DuplicateFiles }" RowBackground="{DynamicResource DataGridRowBackground}" Foreground="{DynamicResource PrimaryText}" MinHeight="150" Margin="0,0,0,15">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource StrColSelect}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{ Binding IsSelected, UpdateSourceTrigger=PropertyChanged }" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{ Binding GroupId }" Header="{DynamicResource StrColGroup}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Binding="{ Binding FileName }" Header="{DynamicResource StrColFileName}" IsReadOnly="True" Width="200"/>
                    <DataGridTextColumn Binding="{ Binding Path }" Header="{DynamicResource StrColPath}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Binding="{ Binding Size }" Header="{DynamicResource StrColSize}" IsReadOnly="True" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Panel -->
            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Grid.Row="3" Margin="0,0,0,15" Padding="15">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Text="{DynamicResource StrLabelSelected}" Margin="0,0,5,0"/>
                        <TextBlock FontSize="14" Foreground="{DynamicResource CardBackground2}" Text="{ Binding SelectedCountText }" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Background="{DynamicResource MutedText}" BorderThickness="0" Command="{ Binding OpenLocationCommand }" Content="{DynamicResource StrBtnOpenLocation}" Foreground="White" Height="35" Margin="0,0,10,0" Width="120"/>
                        <Button Background="{DynamicResource CardBackground2}" BorderThickness="0" Command="{ Binding RecycleBinCommand }" Content="{DynamicResource StrBtnMoveRecycleBin}" Foreground="White" Height="35" Width="150"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
